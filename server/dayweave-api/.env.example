# Generate a unique secret for local development; never commit a real token.
DAYWEAVE_API_TOKENS=replace-with-at-least-24-random-characters
DAYWEAVE_BIND_ADDRESS=127.0.0.1:8080
DAYWEAVE_ENVIRONMENT=development
DAYWEAVE_PROPOSAL_TTL_HOURS=168
# PostgreSQL is optional in development and required in staging/production.
DAYWEAVE_DATABASE_URL=postgres://dayweave:replace-me@127.0.0.1:5432/dayweave
DAYWEAVE_DATABASE_MIN_CONNECTIONS=1
DAYWEAVE_DATABASE_MAX_CONNECTIONS=10
DAYWEAVE_DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
DAYWEAVE_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
DAYWEAVE_DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
DAYWEAVE_OWNER_SUBJECT=personal-owner
DAYWEAVE_DEFAULT_TIMEZONE=Europe/Madrid
# Browser clients must match one of these exact origins. Empty rejects all Origin headers.
DAYWEAVE_MCP_ALLOWED_ORIGINS=
DAYWEAVE_JSON_LOGS=false
RUST_LOG=dayweave_api=info,tower_http=info
