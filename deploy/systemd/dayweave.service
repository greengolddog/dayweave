[Unit]
Description=DayWeave private scheduling service
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dayweave/deploy
ExecStartPre=/opt/dayweave/deploy/scripts/verify-production-env.sh /opt/dayweave/deploy/.env
ExecStart=/usr/bin/docker compose up --detach --remove-orphans
ExecStartPost=/usr/bin/docker compose ps
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
