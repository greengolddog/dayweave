POSTGRES_DB=dayweave
POSTGRES_USER=dayweave
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DAYWEAVE_ENVIRONMENT=production
# Start a reviewed migration in hybrid, enroll both devices and MCP clients,
# then set credential_only and leave DAYWEAVE_API_TOKEN empty.
DAYWEAVE_AUTH_MODE=hybrid
DAYWEAVE_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
DAYWEAVE_DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
DAYWEAVE_OWNER_SUBJECT=personal-owner
DAYWEAVE_DEFAULT_TIMEZONE=Europe/Madrid
DAYWEAVE_API_TOKEN=replace-with-a-separate-long-random-secret
DAYWEAVE_API_IMAGE=ghcr.io/greengolddog/dayweave-api:latest
DAYWEAVE_PUBLIC_BASE_URL=https://replace-after-tunnel-creation
DAYWEAVE_MCP_ALLOWED_ORIGINS=
DAYWEAVE_MCP_OAUTH_ENABLED=false
# Populate these public identifiers only for the reviewed OAuth overlay. They
# are intentionally absent by default; never place access/refresh tokens here.
# DAYWEAVE_MCP_OAUTH_RESOURCE=https://api.example.test/mcp
# DAYWEAVE_MCP_OAUTH_ISSUER=https://tenant.eu.auth0.com/
# DAYWEAVE_MCP_OAUTH_OWNER_SUBJECT=auth0|replace-with-exact-owner-sub
# DAYWEAVE_MCP_OAUTH_CLIENT_IDS=https://chatgpt.com/oauth/client.json
# DAYWEAVE_MCP_OAUTH_ALLOWED_ORIGINS=https://chatgpt.com
# Android assistant inference is an explicit opt-in. When enabling it, store the
# provider key only in the root-owned production environment or secret manager.
DAYWEAVE_ASSISTANT_ENABLED=false
# DAYWEAVE_OPENAI_API_KEY=
# DAYWEAVE_OPENAI_MODEL=gpt-5.6-luna
# DAYWEAVE_ASSISTANT_REQUESTS_PER_MINUTE=6
# DAYWEAVE_ASSISTANT_MAX_CONCURRENT_REQUESTS=2
# DAYWEAVE_ASSISTANT_DAILY_TOKEN_BUDGET=1000000
# DAYWEAVE_ASSISTANT_API_CPUS=1.0
# DAYWEAVE_ASSISTANT_API_MEMORY=768m
# DAYWEAVE_ASSISTANT_API_PIDS=256
RUST_LOG=dayweave_api=info,tower_http=info

# Encrypted backup destination. Keep the age private identity off the VM.
DAYWEAVE_BACKUP_BUCKET=replace-with-private-bucket-name
DAYWEAVE_BACKUP_RECIPIENT=age1replace-with-public-recipient
AWS_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
AWS_ACCESS_KEY_ID=replace-with-backup-service-account-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-service-account-secret
