POSTGRES_DB=dayweave
POSTGRES_USER=dayweave
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DAYWEAVE_API_TOKEN=replace-with-a-separate-long-random-secret
DAYWEAVE_API_IMAGE=ghcr.io/greengolddog/dayweave-api:latest
DAYWEAVE_PUBLIC_BASE_URL=https://replace-after-tunnel-creation
RUST_LOG=dayweave_api=info,tower_http=info

# Encrypted backup destination. Keep the age private identity off the VM.
DAYWEAVE_BACKUP_BUCKET=replace-with-private-bucket-name
DAYWEAVE_BACKUP_RECIPIENT=age1replace-with-public-recipient
AWS_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
AWS_ACCESS_KEY_ID=replace-with-backup-service-account-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-service-account-secret

